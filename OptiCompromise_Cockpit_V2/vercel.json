{
  "git": {
    "deploymentEnabled": {
      "audit/opticompromise-iad": false
    }
  },
  "buildCommand": "cd web && npm run build",
  "outputDirectory": "web/.next",
  "framework": "nextjs",
  "functions": {
    "api/index.py": {
      "includeFiles": "examples/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    }
  ]
}
