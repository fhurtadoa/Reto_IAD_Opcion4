    {"name": "Capacidad Mínima Maletero (L)", "coefficients": [400.0, 594.0, 527.0, 520.0, 318.0, 748.0], "sense": ">=", "rhs": 24000.0},
    {"name": "Presupuesto Máximo Inversión (USD)", "coefficients": [44000.0, 46500.0, 49000.0, 48000.0, 42000.0, 43500.0], "sense": "<=", "rhs": 2350000.0}
  ],
  "weights": [0.3, 0.25, 0.25, 0.2]
