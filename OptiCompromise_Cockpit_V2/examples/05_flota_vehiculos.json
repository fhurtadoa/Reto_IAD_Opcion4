{
  "name": "Adquisición de Flota de Vehículos Eléctricos (Caso Taller IAD)",
  "description": "Evaluación multicriterio para adquisición de flota entre 6 alternativas de vehículos 100% eléctricos: BYD Seal, Tesla Model 3, Hyundai Ioniq 5, Kia EV6, Volvo EX30 y Chevrolet Equinox EV.",
  "variables": [
    {"name": "x1 (BYD Seal)", "var_type": "continuous", "lower_bound": 0.0, "upper_bound": 50.0},
    {"name": "x2 (Tesla Model 3)", "var_type": "continuous", "lower_bound": 0.0, "upper_bound": 50.0},
    {"name": "x3 (Hyundai Ioniq 5)", "var_type": "continuous", "lower_bound": 0.0, "upper_bound": 50.0},
    {"name": "x4 (Kia EV6)", "var_type": "continuous", "lower_bound": 0.0, "upper_bound": 50.0},
    {"name": "x5 (Volvo EX30)", "var_type": "continuous", "lower_bound": 0.0, "upper_bound": 50.0},
    {"name": "x6 (Chevrolet Equinox EV)", "var_type": "continuous", "lower_bound": 0.0, "upper_bound": 50.0}
  ],
  "objectives": [
    {"name": "Costo Total Flota (USD)", "sense": "minimize", "coefficients": [44000.0, 46500.0, 49000.0, 48000.0, 42000.0, 43500.0]},
